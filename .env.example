TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=PokeAI
MONGO_DB_NAME=poke_ai
RUN_PROACTIVE_WORKER_IN_API=true
RUN_PROACTIVE_DECISION_WORKER_IN_API=true
PROACTIVE_DECISION_WORKER_INTERVAL_SECONDS=300
PROACTIVE_DECISION_BATCH_SIZE=50
PROACTIVE_INACTIVITY_HOURS=48
PROACTIVE_DEFAULT_LEVEL=medium
PROACTIVE_LOW_COOLDOWN_HOURS=72
PROACTIVE_MEDIUM_COOLDOWN_HOURS=24
PROACTIVE_HIGH_COOLDOWN_HOURS=6
DEFAULT_TIMEZONE=Africa/Cairo
DEFAULT_QUIET_HOURS_START=23:00
DEFAULT_QUIET_HOURS_END=09:00
